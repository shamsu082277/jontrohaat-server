# Render environment variables. Render supplies PORT; 10000 is for local use.
PORT=10000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=jontrohaat

# Better Auth JWT verification; these URLs must match the Vercel app URL.
# Better Auth MongoDB adapter default model name; usePlural is false.
AUTH_USER_COLLECTION=user
BETTER_AUTH_JWKS_URL=https://your-frontend-domain.vercel.app/api/auth/jwks
JWT_ISSUER=https://your-frontend-domain.vercel.app
JWT_AUDIENCE=https://your-frontend-domain.vercel.app
RESERVATION_MINUTES=60

# Private API keys; never expose these in frontend variables.
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_CURRENCY=bdt
